; Engine configuration file.
config_version=5

[application]

config/name="Magic The Spire"
run/main_scene="res://scenes/title/title_screen.tscn"
config/features=PackedStringArray("4.7")
config/use_custom_user_dir=true
config/custom_user_dir_name="MagicTheSpire"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/NotoSansJP-VF.ttf"

[internationalization]

locale/translations=PackedStringArray("res://localization/ui.ja.translation")
locale/fallback="ja"
locale/test="ja"
